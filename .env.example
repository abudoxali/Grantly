# Grantly Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real credentials to Git.

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Server-Side Only for Admin Bootstrap & Migrations)
# WARNING: NEVER expose SUPABASE_SERVICE_ROLE_KEY to client-side bundles!
SUPABASE_SERVICE_ROLE_KEY=

# Initial Administrator Bootstrap Credentials (used by: npm run bootstrap:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
